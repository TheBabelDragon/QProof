{
  "schema_version": "1.0.0",
  "software": "qproof/0.2.0",
  "circuit_format": {
    "version": "1.0.0",
    "media_type": "application/json",
    "description": "Versioned circuit + experiment JSON (docs/circuit_format.md)"
  },
  "evidence_schema": {
    "version": "1.1.0",
    "backward_compatible_with": ["1.0.0"]
  },
  "simulator": {
    "backend": "classical_statevector",
    "dtype": "complex128",
    "qubit_ordering": "little-endian (qubit 0 = LSB)",
    "max_qubits": 20,
    "max_qubits_browser": 12,
    "noise_model": false,
    "hardware_backends": [],
    "memory_note": "~16 bytes × 2^n; Python soft fail above 20; browser hard fail above 12"
  },
  "execution_modes": [
    {
      "id": "browser_exact",
      "available": true,
      "description": "Exact pure-state simulation in the browser (web/simulator.js)"
    },
    {
      "id": "browser_finite_shot",
      "available": true,
      "description": "Seeded finite-shot sampling in the browser (Mulberry32; not identical to NumPy samples)"
    },
    {
      "id": "classical_statevector",
      "available": true,
      "description": "Exact pure-state simulation in Python/NumPy"
    },
    {
      "id": "precomputed_evidence",
      "available": true,
      "description": "Load previously generated verified JSON reports"
    },
    {
      "id": "quantum_hardware",
      "available": false,
      "description": "No hardware backend is integrated"
    }
  ],
  "gates": {
    "I": {"arity": 1, "params": [], "status": "supported"},
    "X": {"arity": 1, "params": [], "status": "supported"},
    "Y": {"arity": 1, "params": [], "status": "supported"},
    "Z": {"arity": 1, "params": [], "status": "supported"},
    "H": {"arity": 1, "params": [], "status": "supported"},
    "S": {"arity": 1, "params": [], "status": "supported"},
    "T": {"arity": 1, "params": [], "status": "supported"},
    "RX": {"arity": 1, "params": ["theta"], "status": "supported"},
    "RY": {"arity": 1, "params": ["theta"], "status": "supported"},
    "RZ": {"arity": 1, "params": ["theta"], "status": "supported"},
    "CNOT": {"arity": 2, "params": [], "roles": ["control", "target"], "status": "supported"},
    "CX": {"alias_of": "CNOT", "arity": 2, "params": [], "roles": ["control", "target"], "status": "supported"},
    "CZ": {"arity": 2, "params": [], "roles": ["control", "target"], "status": "supported"}
  },
  "unsupported_gates": ["SWAP", "CCNOT", "TOFFOLI", "U", "U1", "U2", "U3", "ISWAP", "RXX", "RYY", "RZZ"],
  "initial_states": {
    "supported": ["zero", "basis_index"],
    "unsupported": ["arbitrary_unnormalized", "mixed_density_matrix"]
  },
  "measurement": {
    "basis": "computational",
    "exact_probabilities": true,
    "shots": true,
    "deterministic_seed": true,
    "mid_circuit": false
  },
  "verification": {
    "outcomes": ["passed", "failed", "inconclusive"],
    "methods": [
      "normalization",
      "finite_amplitudes",
      "amplitude_match_global_phase_invariant",
      "probability_match",
      "pure_state_fidelity",
      "shot_consistency",
      "evidence_schema",
      "integrity_hash"
    ],
    "reference_strategies": ["analytic_closed_form", "invariant_only", "supplied_expected_state"],
    "notes": [
      "Missing report_hash cannot yield hash-verified",
      "Comparing two software paths does not prove hardware correctness"
    ]
  },
  "examples": [
    {"id": "hadamard-v1", "role": "optional template"},
    {"id": "bell-state-v1", "role": "optional smoke fixture"},
    {"id": "rx-pi-v1", "role": "optional rotation fixture"},
    {"id": "global-phase-v1", "role": "optional phase fixture"}
  ],
  "limitations": [
    "Classical simulation only — does not claim quantum advantage.",
    "No noise, error correction, or open-system dynamics.",
    "No mid-circuit measurement or classical feed-forward.",
    "Browser sampling PRNG differs from NumPy; do not require identical shot sequences.",
    "Client-side integrity checks are not a trust boundary against a malicious client."
  ]
}
